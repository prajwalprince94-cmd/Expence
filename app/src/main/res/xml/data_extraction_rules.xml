<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- In local-first app, encrypted exports are preferred over unencrypted cloud auto-backup -->
        <exclude domain="database" path="knowspends.db" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="knowspends.db" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
